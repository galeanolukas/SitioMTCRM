# Ejemplo de archivo .env para SitioMTCRM
# Copiar como .env y completar con valores reales en cada entorno (VPS o POS).

# Entorno
ENVIRONMENT=development
APP_VERSION=1.0.0
POS_SYNC_INTERVAL_SECONDS=300

# Base de datos local
# Para usar PostgreSQL local en desarrollo, configurar estas variables:
# Si están vacías o comentadas, el sistema usará SQLite automáticamente
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Base de datos remota (servidor central) usada por POS locales
REMOTE_DB_NAME=
REMOTE_DB_USER=
REMOTE_DB_PASSWORD=
REMOTE_DB_HOST=
REMOTE_DB_PORT=5432
REMOTE_DB_SSLMODE=require

# Otros secretos sensibles que quieras mover fuera del código
# SECRET_KEY=tu_clave_super_secreta

# Configuración de sincronización de productos
# safe: Preserva stock local (recomendado)
# normal: Sobrescribe stock local (uso con cuidado)
POS_SYNC_PRODUCTS_MODE=safe

# AFIP SDK Configuration
# Obtener access token en https://app.afipsdk.com
AFIP_ACCESS_TOKEN=tu_access_token_aqui
AFIP_CUIT=tu_cuit_aqui
AFIP_ENVIRONMENT=dev  # 'dev' o 'prod'

# Rutas a certificados (solo para producción)
# AFIP_CERT_PATH=/ruta/a/certificado.crt
# AFIP_KEY_PATH=/ruta/a/key.key

# Configuración de sincronización con SitioCatalogoMarcos
# Reemplazar con la URL real del catálogo y la API key generada
CATALOGO_URL=https://catalogo.multilideres.com
CATALOGO_API_KEY=tu_api_key_secreta_aqui
